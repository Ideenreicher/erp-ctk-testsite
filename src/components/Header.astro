---
const BOOKING_URL =
  'https://bookings.cloud.microsoft/book/TerminbuchungBeratungsgesprch@ctk-gmbh.de/?ismsaljsauthenabled=true';

const navLinks = [
  { label: 'Herausforderungen', href: '#herausforderungen' },
  { label: 'Vorteile', href: '#vorteile' },
  { label: 'Vorgehen', href: '#vorgehen' },
  { label: 'mesonic WinLine', href: '#winline' },
  { label: 'Warum CTK', href: '#warum-ctk' },
];
---

<header class="sticky top-0 z-50 relative border-b border-border bg-white/92 backdrop-blur-[12px]">
  <div class="mx-auto flex max-w-7xl h-16 items-center justify-between gap-6 px-6 lg:h-[76px] lg:px-8">
    <a
      href="https://www.ctk-gmbh.de"
      class="flex shrink-0 items-center gap-3"
      aria-label="CTK IT-Lösungen und Service Home"
    >
      <img
        src="/assets/header/ctk-logo.svg"
        alt="CTK IT-Lösungen und Service"
        height="45"
        class="h-[45px] w-auto"
      />
    </a>

    <nav class="hidden items-center gap-6 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[15px] text-foreground transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="ctk-btn ctk-btn--primary ctk-btn--sm hidden sm:inline-flex"
      >
        Termin vereinbaren
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-border bg-white text-foreground transition-colors hover:text-brand lg:hidden"
      >
        <svg id="icon-burger" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="absolute left-0 right-0 top-full hidden flex-col gap-1 border-t border-border bg-white px-6 py-4 shadow-md lg:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-3 py-3 text-[15px] text-foreground transition-colors hover:bg-blue-50 hover:text-brand"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="ctk-btn ctk-btn--primary mt-2"
    >
      Termin vereinbaren
    </a>
  </nav>
</header>

<script is:inline>
  (function () {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconBurger = document.getElementById('icon-burger');
    const iconClose = document.getElementById('icon-close');

    function setOpen(isOpen) {
      mobileMenu.classList.toggle('hidden', !isOpen);
      mobileMenu.classList.toggle('flex', isOpen);
      iconBurger.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
    }

    menuToggle.addEventListener('click', () => {
      setOpen(mobileMenu.classList.contains('hidden'));
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  })();
</script>
