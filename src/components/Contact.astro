---
const FORMINIT_FORM_ID = 'l3y675bax1j';

const fields = [
  { id: 'name', name: 'fi-text-name', label: 'Ihr Name', type: 'text', placeholder: 'z. B. Max Mustermann', required: true },
  { id: 'company', name: 'fi-sender-company', label: 'Unternehmen', type: 'text', placeholder: 'z. B. Musterfirma GmbH', required: true },
];
---

<section id="kontakt" class="bg-ctk-gradient w-full px-5 sm:px-8 ctk-section" data-reveal>
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <div>
      <span class="ctk-pill border border-white/25 bg-white/10 text-white"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>Kontakt</span>
      <h2 class="ctk-h2 mt-4 text-white">
        Lassen Sie uns über Ihre Prozesse sprechen
      </h2>
      <p class="mt-4 max-w-md text-lg leading-relaxed text-white/90">
        Ob ERP-Wechsel, Digitalisierung oder individuelle Anforderungen – wir unterstützen Sie gerne bei der
        Bewertung Ihrer Möglichkeiten.
      </p>

      <form id="contact-form" class="mt-8 space-y-5">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            fields.map((f) => (
              <div>
                <label for={f.id} class="text-sm font-bold text-white">
                  {f.label} {f.required && <span class="text-green-500">*</span>}
                </label>
                <input
                  id={f.id}
                  name={f.name}
                  type={f.type}
                  placeholder={f.placeholder}
                  required={f.required}
                  class="mt-1.5 w-full h-12 px-3.5 rounded-md border border-white/30 bg-white/10 text-base text-white placeholder:text-white/60 focus:border-white focus:bg-white/15 focus:shadow-focus focus:outline-none"
                />
              </div>
            ))
          }
        </div>

        <div>
          <label for="email" class="text-sm font-bold text-white">
            E-Mail-Adresse <span class="text-green-500">*</span>
          </label>
          <input
            id="email"
            name="fi-sender-email"
            type="email"
            placeholder="name@firma.de"
            required
            class="mt-1.5 w-full h-12 px-3.5 rounded-md border border-white/30 bg-white/10 text-base text-white placeholder:text-white/60 focus:border-white focus:bg-white/15 focus:shadow-focus focus:outline-none"
          />
        </div>

        <div>
          <label for="message" class="text-sm font-bold text-white">Ihre Nachricht / Anforderungen</label>
          <textarea
            id="message"
            name="fi-text-message"
            rows="4"
            placeholder="Beschreiben Sie kurz Ihre aktuellen Herausforderungen oder Wünsche…"
            class="mt-1.5 w-full resize-none px-3.5 py-3 rounded-md border border-white/30 bg-white/10 text-base text-white placeholder:text-white/60 focus:border-white focus:bg-white/15 focus:shadow-focus focus:outline-none"
          ></textarea>
        </div>

        <button
          id="contact-form-submit"
          type="submit"
          class="ctk-btn w-full bg-green-500 text-blue-950 hover:bg-green-400 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Jetzt unverbindliches Beratungsgespräch vereinbaren
        </button>

        <p id="contact-form-status" class="text-center text-sm font-bold text-white" role="status" aria-live="polite"></p>
      </form>
    </div>

    <div class="flex flex-col gap-6 rounded-[20px] border border-white/[0.12] bg-white/5 p-7 sm:px-[42px] sm:py-10">
      <div class="flex items-center gap-4">
        <img
          src="/assets/contact/david-werner.jpg"
          alt="David Werner, Vertrieb Business Software bei der CTK GmbH"
          width="62"
          height="62"
          class="block h-[62px] w-[62px] shrink-0 rounded-full border-2 border-white/20 object-cover"
        />
        <div class="flex flex-col gap-0.5">
          <span class="text-lg font-bold text-white">David Werner</span>
          <span class="text-sm text-white/90">Vertrieb Business Software</span>
        </div>
      </div>

      <div class="h-px bg-white/[0.12]"></div>

      <div class="flex flex-col gap-1.5">
        <a href="mailto:david.werner@ctk-gmbh.de" class="flex min-h-11 items-center gap-3 break-words text-[15px] text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-[18px] w-[18px] shrink-0 text-green-500">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          david.werner@ctk-gmbh.de
        </a>
        <a href="tel:+49846364230" class="flex min-h-11 items-center gap-3 text-[15px] text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-[18px] w-[18px] shrink-0 text-green-500">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z" />
          </svg>
          +49 (8463) 64 23-0
        </a>
        <div class="flex items-start gap-3 py-2.5 text-[15px] text-white/90">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-[3px] h-[18px] w-[18px] shrink-0 text-green-500">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>CTK GmbH, An der Gredl 3<br />91171 Greding, Deutschland</span>
        </div>
      </div>

      <div class="inline-flex items-center gap-2 self-start rounded-full bg-green-500/[0.16] px-3.5 py-[7px] text-[13px] font-bold text-green-500">
        <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
        Antwort innerhalb von 24 Stunden
      </div>
    </div>
  </div>
</section>

<script define:vars={{ FORMINIT_FORM_ID }} is:inline>
  (function () {
    const CONSENT_KEY = 'ctk-cookie-consent';

    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-form-submit');
    const statusEl = document.getElementById('contact-form-status');
    const defaultLabel = submitBtn.textContent;

    let forminitClientPromise = null;

    function loadForminitClient() {
      if (!forminitClientPromise) {
        // Astro bundles a plain <script src="https://..."> as a deferred module import, which would
        // run after this classic script — load it ourselves so `Forminit` is guaranteed ready in time.
        forminitClientPromise = import('https://forminit.com/sdk/v1/forminit.js').then(() => new Forminit());
      }
      return forminitClientPromise;
    }

    if (localStorage.getItem(CONSENT_KEY) === 'all') {
      loadForminitClient();
    }
    window.addEventListener('ctk-cookie-consent', (e) => {
      if (e.detail === 'all') loadForminitClient();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (localStorage.getItem(CONSENT_KEY) !== 'all') {
        statusEl.textContent =
          'Für den Versand nutzen wir einen externen Formular-Dienst. Bitte akzeptieren Sie Cookies, um das Formular zu senden.';
        window.ctkOpenCookieSettings?.();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Wird gesendet…';
      statusEl.textContent = '';

      try {
        const forminitClient = await loadForminitClient();
        const formData = new FormData(form);
        const { error } = await forminitClient.submit(FORMINIT_FORM_ID, formData);
        if (error) throw new Error(error.message || 'Unbekannter Fehler');

        form.reset();
        statusEl.textContent = 'Danke! Ihre Nachricht wurde erfolgreich gesendet.';
      } catch (err) {
        statusEl.textContent =
          'Da ist leider etwas schiefgelaufen. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt per E-Mail.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = defaultLabel;
      }
    });
  })();
</script>
