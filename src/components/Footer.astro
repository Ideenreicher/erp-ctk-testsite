---
const links = [
  { label: 'Herausforderungen', href: '#herausforderungen' },
  { label: 'Vorteile', href: '#vorteile' },
  { label: 'Unser Vorgehen', href: '#vorgehen' },
  { label: 'mesonic WinLine', href: '#winline' },
  { label: 'Warum CTK', href: '#warum-ctk' },
  { label: 'Kontakt', href: '#kontakt' },
  { label: 'Impressum', href: 'https://www.ctk-gmbh.de/impressum', external: true },
  { label: 'Datenschutz', href: 'https://www.ctk-gmbh.de/datenschutz', external: true },
  { label: 'Cookie-Einstellungen', href: '#', id: 'footer-cookie-settings' },
];
---

<footer class="w-full border-t border-white/[0.18] bg-brand-dark px-5 py-10 sm:px-8" data-reveal>
  <div class="mx-auto flex max-w-[1200px] flex-col gap-[26px]">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5">
      <img src="/assets/footer/ctk-logo-white.svg" alt="CTK GmbH" class="block h-8 w-auto" />
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {
          links.map((link) => (
            <a
              href={link.href}
              id={link.id}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="inline-flex min-h-11 items-center text-white/90 transition-colors hover:text-white hover:underline"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="h-px bg-white/10"></div>

    <p class="text-[13px] leading-normal text-white/90">
      mesonic WinLine ist ein eingetragenes Warenzeichen der mesonic GmbH.
    </p>

    <p class="text-[13px] leading-normal text-white/90">
      © {new Date().getFullYear()} CTK GmbH. Alle Rechte vorbehalten.
    </p>
  </div>
</footer>

<script is:inline>
  (function () {
    const link = document.getElementById('footer-cookie-settings');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      window.ctkOpenCookieSettings?.();
    });
  })();
</script>
