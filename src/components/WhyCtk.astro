---
const points = [
  {
    title: 'Langjährige ERP-Erfahrung',
    body: 'Erfolgreiche Projekte und Branchenwissen im Mittelstand seit über 30 Jahren.',
    icon: '/assets/why-ctk/icon-history.svg',
  },
  {
    title: 'Eigene Entwicklungsabteilung',
    body: 'Direkte Umsetzung von Sonderwünschen und Spezial-Schnittstellen.',
    icon: '/assets/why-ctk/icon-code.svg',
  },
  {
    title: 'Persönliche Ansprechpartner',
    body: 'Kein anonymes Call-Center, sondern feste Techniker für Ihr Projekt.',
    icon: '/assets/why-ctk/icon-person.svg',
  },
  {
    title: 'Langfristige Betreuung',
    body: 'Wir lassen Sie nach dem Go-Live nicht allein, sondern optimieren weiter.',
    icon: '/assets/why-ctk/icon-heart.svg',
  },
];
---

<section id="warum-ctk" class="relative overflow-hidden bg-surface ctk-section" data-reveal>
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-3 px-6 lg:grid-cols-4 lg:px-8">
    <!-- Bento: Intro -->
    <div class="flex flex-col items-start justify-center rounded-lg border border-border bg-white p-6 sm:p-8 lg:col-span-2">
      <span class="ctk-pill"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>Warum CTK?</span>
      <h2 class="ctk-h2 mt-4 text-foreground">Darum sollten Sie uns kennenlernen</h2>
      <p class="ctk-lead mt-4 max-w-md text-foreground">
        Viele Anbieter verkaufen ERP-Systeme. Viele Entwickler programmieren individuelle Anpassungen.
        <strong class="font-bold">Wir verbinden beides.</strong>
      </p>
    </div>

    <!-- Bento: Bild -->
    <div class="relative min-h-[260px] overflow-hidden rounded-lg border border-border lg:col-span-2 lg:row-span-2">
      <img
        src="/assets/why-ctk/entwickler-arbeitsplatz.jpg"
        alt="CTK-Entwickler am Arbeitsplatz mit zwei Monitoren: links eine ERP-Oberfläche, rechts Quellcode"
        width="1436"
        height="886"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>

    <!-- Bento: Argumente -->
    {
      points.map((p, i) => (
        <div
          class:list={[
            'flex flex-col gap-4 rounded-lg p-6 sm:p-8',
            i === 3 ? 'bg-brand' : 'border border-border bg-white',
            i >= 2 ? 'lg:col-span-2' : 'lg:col-span-1',
          ]}
        >
          <span class="flex size-11 shrink-0 items-center justify-center rounded-md border border-accent bg-accent-soft">
            <img src={p.icon} alt="" class="size-5 -scale-y-100" />
          </span>
          <div>
            <p class:list={['text-lg leading-tight font-bold', i === 3 ? 'text-white' : 'text-foreground']}>{p.title}</p>
            <p class:list={['mt-1 text-base', i === 3 ? 'text-white/80' : 'text-muted']}>{p.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
