---
const benefits = [
  {
    title: 'Individuelle Beratung statt Standard',
    body: 'Wir richten uns nach Ihren Abläufen, nicht nach Schema F.',
  },
  {
    title: 'Prozess- und Digitalisierungskompetenz',
    body: 'Tiefes Verständnis für moderne, digitale Geschäftsmodelle.',
  },
  {
    title: 'IT, Software & Entwicklung aus einer Hand',
    body: 'Keine Schnittstellenprobleme oder Zuständigkeits-Debatten.',
  },
  {
    title: 'Persönliche Betreuung',
    body: 'Ein fester Ansprechpartner von der Analyse über den Go-Live hinaus.',
  },
];
---

<section id="vorteile" class="bg-background py-24" data-reveal>
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-12 px-6 lg:grid-cols-2 lg:px-8">
    <div>
      <div
        class="relative aspect-[544/308] w-full overflow-hidden rounded-xl bg-blue-50"
      >
        <img
          src="/assets/solution/team-photo.png"
          alt="Das CTK-Team in Firmen-Poloshirts"
          class="absolute inset-0 h-full w-full object-cover object-top"
        />
      </div>

      <p class="ctk-overline-blue mt-8">Lösungsansatz &amp; Philosophie</p>
      <h2 class="ctk-h2 mt-3 text-foreground">
        ERP mit Verständnis für Ihr Business
      </h2>
      <p class="ctk-lead mt-4 max-w-lg text-muted">
        Unser Ziel ist es, eine ERP-Lösung zu schaffen, die Ihre Abläufe vereinfacht, Prozesse automatisiert und Ihr
        Unternehmen langfristig unterstützt.
      </p>
    </div>

    <div class="ctk-card-hover rounded-lg border border-green-300 bg-accent-soft p-8 sm:p-10">
      <h3 class="text-2xl font-bold tracking-[-0.015em] text-foreground">Ihre Vorteile mit CTK</h3>
      <ul class="mt-7 flex flex-col gap-7">
        {
          benefits.map((b) => (
            <li class="flex flex-col gap-2 sm:flex-row sm:gap-5">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent text-on-accent sm:mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <div>
                <p class="font-bold text-foreground">{b.title}</p>
                <p class="mt-0.5 text-base text-muted">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
