---
const modules = [
  {
    title: 'Warenwirtschaft',
    body: 'Zentrale Verwaltung von Lagern, Artikeln, Bestellungen und Logistikabläufen.',
    icon: '/assets/technical/icon-warenwirtschaft.svg',
  },
  {
    title: 'Finanzbuchhaltung',
    body: 'Revisionssichere Buchhaltung, Umsatzsteueranmeldung und Bilanzerstellung.',
    icon: '/assets/technical/icon-finanzbuchhaltung.svg',
  },
  {
    title: 'Einkauf & Vertrieb',
    body: 'Automatisierte Angebotsprozesse, Preiskalkulationen und Lieferantenmanagement.',
    icon: '/assets/technical/icon-einkauf-vertrieb.svg',
  },
  {
    title: 'Controlling',
    body: 'Echtzeitauswertungen, Budgets und finanzielle Kennzahlen auf Knopfdruck.',
    icon: '/assets/technical/icon-controlling.svg',
  },
  {
    title: 'CRM',
    body: 'Umfassende Kundenbetreuung, lückenlose Kontakthistorie und Vertriebspipelines.',
    icon: '/assets/technical/icon-crm.svg',
  },
  {
    title: 'Dokumentenmanagement',
    body: 'GoBD-konforme Archivierung und schneller Zugriff auf alle Dokumente.',
    icon: '/assets/technical/icon-dokumentenmanagement.svg',
  },
  {
    title: 'Produktion',
    body: 'Effiziente Produktionsplanung, Ressourcensteuerung (PPS) und Fertigungsaufträge.',
    icon: '/assets/technical/icon-produktion.svg',
  },
];
---

<section id="winline" class="bg-background py-24" data-reveal>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <p class="ctk-overline-blue">Die technische Basis</p>
    <h2 class="ctk-h2 mt-2 text-foreground">
      mesonic WinLine
    </h2>
    <p class="ctk-lead mt-4 max-w-2xl text-muted">
      Seit vielen Jahren setzen wir erfolgreich auf die etablierte ERP-Lösung
      <strong class="font-bold text-foreground">mesonic WinLine</strong>. Die Software vereint alle zentralen
      Unternehmensbereiche in einem einzigen, modular erweiterbaren System.
    </p>

    <div class="mt-12 flex items-center justify-end gap-2">
      <button
        id="tech-slider-prev"
        type="button"
        aria-label="Vorherige Module"
        class="flex size-11 items-center justify-center rounded-full bg-button text-white transition-colors hover:bg-button-hover disabled:pointer-events-none disabled:opacity-30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button
        id="tech-slider-next"
        type="button"
        aria-label="Nächste Module"
        class="flex size-11 items-center justify-center rounded-full bg-button text-white transition-colors hover:bg-button-hover disabled:pointer-events-none disabled:opacity-30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>
    </div>

    <div
      id="tech-slider"
      class="mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-1 py-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        modules.map((m) => (
          <div class="shrink-0 snap-start basis-full ctk-card-hover rounded-lg border border-border bg-white p-6 md:basis-[calc(50%-8px)]">
            <img src={m.icon} alt="" class="size-8 -scale-y-100" />
            <h3 class="mt-3 text-base font-bold text-foreground">{m.title}</h3>
            <p class="mt-1.5 text-base break-words text-muted">{m.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="flex flex-col items-center gap-6 ctk-card-hover rounded-lg border border-blue-200 bg-blue-50 p-6 text-center sm:flex-row sm:text-left">
        <img src="/assets/technical/mesonic-logo.png" alt="mesonic" class="h-[43px] w-auto shrink-0" />
        <div class="flex items-center gap-3">
          <img src="/assets/technical/icon-check-badge.svg" alt="" class="size-7 shrink-0 -scale-y-100" />
          <p class="text-sm leading-snug">
            <span class="block font-bold text-foreground">Zertifizierter Partner</span>
            <span class="text-muted">Erfahrene mesonic-Experten</span>
          </p>
        </div>
      </div>

      <div
        class="relative overflow-hidden rounded-lg bg-brand-dark p-8"
      >
        <img
          src="/assets/technical/icon-gear-callout.svg"
          alt=""
          class="pointer-events-none absolute right-[-20px] bottom-[-28px] size-32 -scale-y-100"
        />
        <h3 class="ctk-h3 relative text-white">Individuelle Anpassung</h3>
        <p class="relative mt-2 max-w-md text-base text-white/80">
          Als zertifizierter Partner passen wir alle Module von mesonic WinLine exakt an Ihre spezifischen
          Branchenanforderungen an.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const slider = document.getElementById('tech-slider');
    const prev = document.getElementById('tech-slider-prev');
    const next = document.getElementById('tech-slider-next');
    if (!slider || !prev || !next) return;

    function updateButtons() {
      prev.disabled = slider.scrollLeft <= 4;
      next.disabled = slider.scrollLeft >= slider.scrollWidth - slider.clientWidth - 4;
    }

    prev.addEventListener('click', () => slider.scrollBy({ left: -slider.clientWidth, behavior: 'smooth' }));
    next.addEventListener('click', () => slider.scrollBy({ left: slider.clientWidth, behavior: 'smooth' }));
    slider.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', updateButtons);
    updateButtons();
  })();
</script>
