---
const BOOKING_URL =
  'https://bookings.cloud.microsoft/book/TerminbuchungBeratungsgesprch@ctk-gmbh.de/?ismsaljsauthenabled=true';

const steps = [
  {
    n: 1,
    title: 'Verstehen',
    body: 'Analyse Ihrer bestehenden Prozesse, Anforderungen und individuellen Herausforderungen im operativen Geschäft.',
  },
  {
    n: 2,
    title: 'Konzipieren',
    body: 'Entwicklung eines individuellen, tragfähigen ERP-Konzepts, das exakt auf Ihre Unternehmensziele abgestimmt ist.',
  },
  {
    n: 3,
    title: 'Implementieren',
    body: 'Professionelle Einführung der Software, sichere Migration Ihrer Altdaten und praxisnahe Mitarbeiterschulungen.',
  },
  {
    n: 4,
    title: 'Optimieren',
    body: 'Feinjustierung und kontinuierliche Anpassung der Workflows auf Basis der täglichen Praxiserfahrung.',
  },
  {
    n: 5,
    title: 'Begleiten',
    body: 'Zuverlässiger, langfristiger Support, laufende Updates und kontinuierliche Weiterentwicklung Ihres Systems.',
  },
];
---

<section id="vorgehen" class="relative overflow-hidden bg-blue-50 py-20 md:py-24">
  <div class="relative mx-auto max-w-[1200px] px-6 lg:px-8">
    <div class="text-center" data-reveal>
      <p class="ctk-overline-blue">Der Weg zum Erfolg</p>
      <h2 class="ctk-h2 mt-3 pb-4 text-foreground">
        Unser Vorgehen
      </h2>
    </div>

    <div class="relative mx-auto mt-10 max-w-[900px] md:mt-14">
      <div class="absolute top-0 bottom-0 left-1/2 hidden w-[2px] -translate-x-1/2 bg-accent md:block"></div>

      <ol class="flex flex-col gap-8 md:gap-10">
        {
          steps.map((step, i) => (
            <li class="md:grid md:grid-cols-2 md:gap-x-20">
              <div
                class:list={[
                  'ctk-card-hover rounded-lg border border-border bg-white p-6 sm:p-8',
                  step.n % 2 === 1 ? 'md:col-start-2' : 'md:col-start-1',
                ]}
                data-reveal
                style={`transition-delay: ${i * 150}ms;`}
              >
                <div class="flex items-center gap-3">
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand text-lg font-bold text-white">
                    {step.n}
                  </span>
                  <h3 class="ctk-h3 text-foreground">{step.title}</h3>
                </div>
                <p class="mt-3 text-base text-muted">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-10 text-center md:mt-14" data-reveal style={`transition-delay: ${steps.length * 150}ms;`}>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="ctk-btn ctk-btn--primary"
      >
        Unverbindliches Beratungsgespräch vereinbaren
      </a>
    </div>
  </div>
</section>
